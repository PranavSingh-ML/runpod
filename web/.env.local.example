# Copied to .env.local by the settings panel in the app; you can also edit by hand.
POD_URL=https://<POD_ID>-8000.proxy.runpod.net
API_TOKEN=<same value as the pod's API_TOKEN env>
POD_RATE_USD_HR=0.49
# optional - enables the prompt rewriter toggle
ANTHROPIC_API_KEY=
# delete the pod after this many idle minutes (0 = off); needs tools/runpodctl.exe
AUTO_STOP_MIN=20
# image used by the in-app Start button
POD_IMAGE=ghcr.io/pranavsingh-ml/imgedit:v2
